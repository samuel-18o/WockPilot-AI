    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json;\n\nconst toolsUsed = (agentOutput.intermediateSteps || [])\n  .map(step => step.action?.tool)\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    reply: agentOutput.output,\n    toolUsed: toolsUsed.length > 0 ? toolsUsed[0] : null,\n    sessionId: $('Webhook').first().json.body.sessionId\n  }\n}];"
